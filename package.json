{
  "name": "zero-two-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Bot Discord profissional inspirado na Zero Two (Darling in the Franxx)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "deploy": "ts-node scripts/deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "zero-two",
    "economy",
    "social",
    "typescript"
  ],
  "author": "Manus AI",
  "license": "MIT",
  "dependencies": {
    "canvas": "^2.11.2",
    "chalk": "^4.1.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.2",
    "ms": "^2.1.3",
    "node-cron": "^3.0.3",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/express": "^4.17.21",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.1.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1"
  }
}
